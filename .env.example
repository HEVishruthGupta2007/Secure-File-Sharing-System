# Copy this file to .env and fill in real values. Never commit the real .env.

# Any long random string — used to sign session cookies.
SECRET_KEY=change-this-to-a-long-random-string

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=paste-your-generated-fernet-key-here

# Default is fine for local development (a SQLite file under instance/).
DATABASE_URL=sqlite:///instance/app.db
